{
  "name": "Readmission Theme",
  "dataColors": ["#0B6FD6", "#9FB3C8", "#D64545", "#F2A93B", "#2E8B7A", "#6C5CE7"],
  "background": "#FFFFFF",
  "foreground": "#2B3640",
  "tableAccent": "#0B6FD6",
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E8EE" } }, "radius": 8 }],
        "title": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 12, "fontColor": { "solid": { "color": "#2B3640" } } }],
        "visualHeader": [{ "show": false }]
      }
    }
  }
}